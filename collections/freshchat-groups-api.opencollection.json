{
  "opencollection": "1.0.0",
  "info": {
    "name": "Freshchat REST Accounts Groups API",
    "version": "v2"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Groups",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "listGroups",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{account}.freshchat.com/v2/groups"
          }
        }
      ]
    }
  ],
  "bundled": true
}